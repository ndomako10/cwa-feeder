# yamllint's defaults, loosened where they fight common YAML style.
extends: default

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: disable
  line-length:
    max: 120
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    # GitHub Actions' `on:` key is a string to Actions, not a boolean.
    check-keys: false
